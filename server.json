{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "co.hirelayer/hirelayer",
  "title": "HireLayer",
  "description": "Resume parsing, scoring and ranking, talent pool search and skills for recruiting AI agents.",
  "websiteUrl": "https://hirelayer.co",
  "repository": {
    "url": "https://github.com/HireLayer/hirelayer-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://hirelayer.co/favicon/android-chrome-512x512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "version": "2.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "hirelayer-mcp",
      "version": "2.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "HIRELAYER_API_KEY",
          "description": "HireLayer API key. Free plan with 50 credits a month at https://hirelayer.co",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://hirelayer.co/mcp"
    }
  ]
}
